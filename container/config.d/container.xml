<?xml version="1.0"?>
<clickhouse>
    <logger>
        <level>information</level>
        <console>true</console>
        <log remove="remove"/>
        <errorlog remove="remove"/>
    </logger>

    <!-- Continue cleanly when the host has IPv6 disabled. -->
    <listen_try>1</listen_try>
    <listen_host>::</listen_host>
    <listen_host>0.0.0.0</listen_host>

    <!-- Generated on the required /tmp mount so custom data paths remain consistent. -->
    <users_config>/tmp/clickhouse-entrypoint/users.xml</users_config>
</clickhouse>
